<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned to the lowest supported TFM's C# version so language semantics are reproducible
         across the net8/net9/net10 SDKs (matches the deterministic-build intent below). -->
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Assinafy.Sdk</RootNamespace>
    <AssemblyName>Assinafy.Sdk</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned (not 'latest') so the analyzer set is deterministic regardless of which
         installed .NET SDK runs the multi-target (net8/9/10) build in CI. -->
    <AnalysisLevel>8.0</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Do NOT suppress CS1591 (missing XML doc): with TreatWarningsAsErrors this enforces that
         every public API member is documented. -->
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Assinafy.Sdk</PackageId>
    <Version>1.3.0</Version>
    <Authors>Assinafy</Authors>
    <Company>Assinafy</Company>
    <Product>Assinafy .NET SDK</Product>
    <Description>Official .NET SDK for the Assinafy digital signature API. Covers authentication, documents, signers, signing flows, assignments, fields, templates, tags, public documents, signature images, and webhooks.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>assinafy;esignature;digital-signature;signature;contracts;brazil;sdk</PackageTags>
    <RepositoryUrl>https://github.com/assinafy/csharp-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://api.assinafy.com.br/v1/docs</PackageProjectUrl>
    <!-- Embed debug symbols and SourceLink metadata directly in the assembly so source-stepping
         works from any feed (GitHub Packages has no symbol server), without a separate .snupkg. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assinafy.Sdk.Tests" />
  </ItemGroup>

</Project>
